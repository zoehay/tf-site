# /etc/systemd/system/e-commerce.service
[Unit]
Description=E-commerce server and db via Docker Compose
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=ec2-user
WorkingDirectory=/opt/app/site/compose/e-commerce

ExecStart=/usr/bin/docker compose -f /opt/app/site/compose/e-commerce/compose.yml up --detach 
ExecStop=/usr/bin/docker compose -f /opt/app/site/compose/e-commerce/compose.yml down
ExecReload=/usr/bin/docker compose -f /opt/app/site/compose/e-commerce/compose.yml compose up -d --remove-orphans

Restart=on-failure
RestartSec=10s
TimeoutStartSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=e-commerce

[Install]
WantedBy=multi-user.target
