# /etc/systemd/system/proxy.service
[Unit]
Description=Proxy nginx via Docker Compose
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/compose/proxy

ExecStart=/usr/bin/docker compose -f /opt/app/proxy/compose.yml up --detach 
ExecStop=/usr/bin/docker compose -f /opt/app/proxy/compose.yml down
ExecReload=/usr/bin/docker compose -f /opt/app/proxy/compose.yml exec -T nginx nginx -s reload

Restart=on-failure
RestartSec=10s
TimeoutStartSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=personal-site-proxy

[Install]
WantedBy=multi-user.target







